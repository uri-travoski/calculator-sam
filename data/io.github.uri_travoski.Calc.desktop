[Desktop Entry]
Type=Application
Name=Calculator.Sam
GenericName=Calculator
Comment=Minimal, fast calculator
Exec=sam-calc
Icon=io.github.uri_travoski.Calc
Terminal=false
Categories=GTK;Utility;Calculator;
Keywords=calculator;math;arithmetic;
StartupNotify=true
StartupWMClass=io.github.uri_travoski.Calc
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sam-calc --new-window
